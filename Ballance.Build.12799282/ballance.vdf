"InstallScript"
{
	"Run Process"
	{
		"DirectPlay 10-64"
		{
			"HasRunKey"		"HKEY_LOCAL_MACHINE\\SOFTWARE\\Valve\\Steam\\Apps\\2000770"
			"Process 1"		"%SYSTEMROOT%\\SysWOW64\\DISM.EXE"
			"Command 1"		"/Online /enable-feature /FeatureName:DirectPlay /all /NoRestart"
			"Requirement_OS"
			{
				"OSType"		"Windows 10"
				"Is64BitWindows"		"1"
			}
		}
		"DirectPlay 11-64"
		{
			"HasRunKey"		"HKEY_LOCAL_MACHINE\\SOFTWARE\\Valve\\Steam\\Apps\\2000770"
			"Process 1"		"%SYSTEMROOT%\\SysWOW64\\DISM.EXE"
			"Command 1"		"/Online /enable-feature /FeatureName:DirectPlay /all /NoRestart"
			"Requirement_OS"
			{
				"OSType"		"Windows 11"
				"Is64BitWindows"		"1"
			}
		}
		"DirectPlay 10-32"
		{
			"HasRunKey"		"HKEY_LOCAL_MACHINE\\SOFTWARE\\Valve\\Steam\\Apps\\2000770"
			"Process 1"		"%SYSTEMROOT%\\System32\\DISM.EXE"
			"Command 1"		"/Online /enable-feature /FeatureName:DirectPlay /all /NoRestart"
			"Requirement_OS"
			{
				"OSType"		"Windows 10"
				"Is64BitWindows"		"0"
			}
		}
		"AppCompat 10-64"
		{
			"HasRunKey"		"HKEY_CURRENT_USER\\SOFTWARE\\Valve\\Steam\\Apps\\2000770"
			"Process 1"		"%SYSTEMROOT%\\SysWOW64\\REG.EXE"
			"Command 1"		"ADD \"HKCU\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Layers\" /v \"%INSTALLDIR%\\bin\\player.exe\" /t REG_SZ /d \"HIGHDPIAWARE\" /f"
			"MinimumHasRunValue"		"3"
			"Requirement_OS"
			{
				"OSType"		"Windows 10"
				"Is64BitWindows"		"1"
			}
		}
