<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BallanceRevival</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 3D rendering / window / input / audio, includes osx-arm64 native libraries -->
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
    <!-- Pure C# rigid-body physics: ball, boxes, mesh collision -->
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
  </ItemGroup>

</Project>
